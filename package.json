{
  "name": "@fourdigit/stylelint-config-fourdigit",
  "version": "5.0.0",
  "description": "The shareable stylelint config for Fourdigit production.",
  "keywords": [
    "stylelint",
    "stylelint-config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fourdigit/stylelint-config-fourdigit.git"
  },
  "bugs": {
    "url": "https://github.com/fourdigit/stylelint-config-fourdigit/issues"
  },
  "homepage": "https://github.com/fourdigit/stylelint-config-fourdigit#readme",
  "author": "FOURDIGIT Inc.",
  "license": "MIT",
  "main": "index.js",
  "files": [
    "index.js"
  ],
  "engines": {
    "node": ">=18.12.0"
  },
  "scripts": {
    "test": "npm run test:valid && npm run test:invalid",
    "test:valid": "stylelint ./spec/mocks/valid.{css,scss} --config ./index.js",
    "test:invalid": "stylelint ./spec/mocks/invalid.{css,scss} --config ./index.js 2>&1 | grep -q 'problems' && echo 'Invalid files correctly detected errors'",
    "fix": "stylelint ./spec/mocks/valid.{css,scss} --fix --config ./index.js"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^3.0.0",
    "stylelint": "^16.8.0",
    "stylelint-config-recess-order": "^4.6.0",
    "stylelint-config-standard-scss": "^13.0.0"
  },
  "peerDependencies": {
    "@stylistic/stylelint-plugin": "^3.0.0",
    "stylelint": "^16.8.0",
    "stylelint-config-recess-order": "^4.6.0",
    "stylelint-config-standard-scss": "^13.0.0"
  }
}
